import { promises as fs } from 'fs';
import path from 'path';
import { parse, stringify } from 'yaml';

export type Credential = {
  id?: string;
  label?: string;
  auth_type?: string;
  source?: string;
  value?: unknown;
  [k: string]: unknown;
};

export interface AuthDoc {
  version?: number;
  providers?: Record<string, Credential[]>;
  active_provider?: string | null;
  credential_pool?: Record<string, Credential[]>;
  [k: string]: unknown;
}

export type SourceFormat = 'json' | 'yaml' | 'env';
export interface SourceDef {
  file: string;
  fmt: SourceFormat;
}

export interface SourceStatus {
  file: string;
  fmt: SourceFormat;
  exists: boolean;
  last_ok: string | null;
}

export const DEFAULT_SOURCES: SourceDef[] = [
  { file: `${process.env.HOME}/.hermes/auth.json`, fmt: 'json' },
  { file: `${process.env.HOME}/.config/opencode/auth.json`, fmt: 'json' },
  { file: `${process.env.HOME}/dev/02-ai-omniroute/config.yaml`, fmt: 'yaml' },
  { file: `${process.env.HOME}/dev/02-ai-freellm-api/.env`, fmt: 'env' },
];

export async function readJson(filePath: string): Promise<AuthDoc> {
  try {
    const data = await fs.readFile(filePath, 'utf8');
    return JSON.parse(data) as AuthDoc;
  } catch {
    return {};
  }
}

export async function readYaml(filePath: string): Promise<AuthDoc> {
  try {
    const data = await fs.readFile(filePath, 'utf8');
    const doc = (parse(data) as AuthDoc) ?? {};
    return normalizeAuthDoc(doc);
  } catch {
    return {};
  }
}

export async function readEnv(filePath: string): Promise<AuthDoc> {
  const pool: Record<string, Credential[]> = {};
  try {
    const data = await fs.readFile(filePath, 'utf8');
    const lines = data.split('\n');
    for (const line of lines) {
      const trimmed = line.trim();
      if (!trimmed || trimmed.startsWith('#') || !trimmed.includes('=')) continue;
      const [key, val] = trimmed.split('=', 2);
      const provider = key.toLowerCase().includes('openrouter')
        ? 'openrouter'
        : key.toLowerCase().includes('gemini')
          ? 'gemini'
          : key.toLowerCase().includes('xai')
            ? 'xai'
            : null;
      if (!provider) continue;
      pool[provider] = pool[provider] ?? [];
      pool[provider].push({
        id: key,
        label: key,
        auth_type: 'api_key',
        source: `env:${key}`,
        value: val,
      });
    }
  } catch {
    return {};
  }
  return { credential_pool: pool };
}

function normalizeAuthDoc(doc: AuthDoc): AuthDoc {
  if (!doc.credential_pool && doc.providers) {
    doc.credential_pool = doc.providers;
  }
  return doc;
}

function denormalizeForWrite(doc: AuthDoc, fmt: SourceFormat): AuthDoc {
  const output = { ...doc };
  if (fmt === 'yaml' && output.credential_pool) {
    output.providers = output.credential_pool;
    delete output.credential_pool;
  }
  return output;
}

export function credKey(c: Credential): string {
  if (c.id) return `id:${c.id}`;
  if (c.source) return `src:${c.source}`;
  if (c.label) return `lbl:${c.label}`;
  return `val:${JSON.stringify(c.value ?? c)}`;
}

export function mergePools(
  target: Record<string, Credential[]> | undefined,
  sources: Record<string, Credential[]>[]
): Record<string, Credential[]> {
  const out: Record<string, Credential[]> = {};
  const providers = new Set<string>();
  if (target) for (const p of Object.keys(target)) providers.add(p);
  for (const source of sources) if (source) for (const p of Object.keys(source)) providers.add(p);

  for (const provider of providers) {
    const seen = new Set<string>();
    const merged: Credential[] = [];

    for (const cred of target?.[provider] ?? []) {
      const key = credKey(cred);
      if (!seen.has(key)) {
        seen.add(key);
        merged.push(cred);
      }
    }

    for (const source of sources) {
      for (const cred of source?.[provider] ?? []) {
        const key = credKey(cred);
        if (!seen.has(key)) {
          seen.add(key);
          merged.push(cred);
        }
      }
    }

    out[provider] = merged;
  }

  return out;
}

export async function fileExists(filePath: string): Promise<boolean> {
  return fs.access(filePath).then(() => true).catch(() => false);
}

export async function readSource(source: SourceDef): Promise<AuthDoc> {
  if (!(await fileExists(source.file))) return {};
  if (source.fmt === 'json') return await readJson(source.file);
  if (source.fmt === 'yaml') return await readYaml(source.file);
  if (source.fmt === 'env') return readEnv(source.file);
  return {};
}

export async function readSources(sources: SourceDef[] = DEFAULT_SOURCES) {
  const harvested: Array<{ file: string; fmt: SourceFormat; doc: AuthDoc }> = [];
  for (const source of sources) {
    if (!(await fileExists(source.file))) continue;
    const doc = await readSource(source);
    harvested.push({ file: source.file, fmt: source.fmt, doc });
  }
  return harvested;
}

export async function writeSource(
  harvest: { file: string; fmt: SourceFormat; doc: AuthDoc },
  unified: Record<string, Credential[]>
): Promise<void> {
  const merged: AuthDoc = {
    ...harvest.doc,
    credential_pool: mergePools(harvest.doc.credential_pool, [unified]),
  };
  const payload = denormalizeForWrite(merged, harvest.fmt);

  if (harvest.fmt === 'json') {
    await fs.writeFile(harvest.file, JSON.stringify(payload, null, 2), 'utf8');
    return;
  }

  if (harvest.fmt === 'yaml') {
    await fs.writeFile(harvest.file, stringify(payload), 'utf8');
    return;
  }

  if (harvest.fmt === 'env') {
    const lines: string[] = [];
    const pool = merged.credential_pool ?? {};
    for (const [provider, creds] of Object.entries(pool)) {
      for (const cred of creds) {
        const name = (cred.label ?? cred.id ?? provider).toString().toUpperCase().replace(/[^A-Z0-9_]/g, '_');
        if (typeof cred.value === 'string') lines.push(`${name}=${cred.value}`);
      }
    }
    await fs.writeFile(harvest.file, lines.join('\n') + '\n', 'utf8');
    return;
  }
}

export async function writeCentralPool(
  pool: Record<string, Credential[]>,
  poolPath = path.resolve(process.cwd(), 'credential-pool.json'),
  options?: { durationMs?: number; sourcesStatus?: SourceStatus[] }
): Promise<void> {
  const totalKeys = Object.values(pool).flat().length;
  const now = new Date().toISOString();
  const doc: AuthDoc = {
    version: '1.0.0',
    last_sync: now,
    last_sync_duration_ms: options?.durationMs ?? 0,
    last_sync_result: 'ok',
    providers: pool,
    cron: {
      enabled: false,
      schedule: '*/30 * * * *',
      last_run: null,
      next_run: null,
    },
    sync_metadata: {
      total_keys: totalKeys,
      providers_active: Object.keys(pool).filter((p) => (pool[p]?.length ?? 0) > 0),
      sources_synced: options?.sourcesStatus ?? [],
    },
  };

  // Preserve existing cron config if central pool already has it
  try {
    const existing = JSON.parse(await fs.readFile(poolPath, 'utf8'));
    if (existing.cron) {
      doc.cron = { ...doc.cron, ...existing.cron };
    }
  } catch { /* file doesn't exist yet */ }

  await fs.writeFile(poolPath, JSON.stringify(doc, null, 2), 'utf8');
}

export async function sync(
  sources: SourceDef[] = DEFAULT_SOURCES,
  poolPath = path.resolve(process.cwd(), 'credential-pool.json')
): Promise<{ pool: Record<string, Credential[]>; harvested: Array<{ file: string; fmt: SourceFormat; doc: AuthDoc }>; durationMs: number }> {
  const startTime = Date.now();
  const harvested = await readSources(sources);
  const pools = harvested.map((h) => h.doc.credential_pool ?? {});
  const unified = mergePools(undefined, pools);
  const durationMs = Date.now() - startTime;

  // Build per-source status
  const sourcesStatus: SourceStatus[] = sources.map((src) => ({
    file: src.file,
    fmt: src.fmt,
    exists: harvested.some((h) => h.file === src.file),
    last_ok: harvested.some((h) => h.file === src.file) ? new Date().toISOString() : null,
  }));

  await writeCentralPool(unified, poolPath, { durationMs, sourcesStatus });

  for (const harvest of harvested) {
    try {
      await writeSource(harvest, unified);
    } catch (err) {
      console.error(`Failed writing source ${harvest.file}:`, err);
    }
  }

  console.log(`✅ Synced ${Object.keys(unified).length} providers and ${Object.values(unified).flat().length} credentials.`);
  return { pool: unified, harvested, durationMs };
}

export default sync;

if (process.argv[1]?.endsWith('src/index.ts') || process.argv[1]?.endsWith('index.ts')) {
  sync().catch((err) => {
    console.error('❌ Sync failed:', err);
    process.exit(1);
  });
}

