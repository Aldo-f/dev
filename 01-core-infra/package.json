{
  "name": "01-core-infra",
  "version": "1.0.0",
  "description": "One-command install: curl -o- https://raw.githubusercontent.com/Aldo-f/01-core-infra/main/install.sh | bash",
  "private": true,
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "bash tests/run-all.sh",
    "test:lint": "bash -c 'cd ansible && find . -name \"*.yml\" -not -path \"./.github/*\" -exec yamllint -d relaxed {} +' 2>/dev/null; bash tests/run-all.sh lint-only 2>/dev/null || bash tests/run-all.sh",
    "precommit": "bash .husky/pre-commit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aldo-f/01-core-infra.git"
  },
  "keywords": [],
