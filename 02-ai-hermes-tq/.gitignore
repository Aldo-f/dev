---
# .gitignore
---

# Python artefacts
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg

# Virtual environment
.venv/

# Build artefacts
build/
Dist/
*.egg

# FastAPI static files (just in case)
static/

# Tasks runtime data (do NOT commit runtime state)
/tasks/

# IDE / editor artefacts
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
