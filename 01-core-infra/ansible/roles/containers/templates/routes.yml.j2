http:
  routers:
{% for r in traefik_routes %}
    {{ r.name }}:
      rule: "Host(`{{ r.host }}`)"
      entryPoints:
        - websecure
      service: {{ r.service }}
      tls:
        certResolver: {{ traefik_tls_certresolver }}
{% if r.middlewares | default([]) %}
      middlewares:
{% for mw in r.middlewares %}
        - {{ mw }}
{% endfor %}
{% endif %}
{% endfor %}

  services:
{% for name, b in traefik_backends | dictsort %}
    {{ name }}:
      loadBalancer:
        servers:
          - url: "{{ b.url }}"
{% if b.tls_skip_verify | default(false) %}
        # singular key, loadBalancer level -> references http.serversTransports
        serversTransport: no-verify-tls
{% endif %}
{% endfor %}

  # For backends serving HTTPS with self-signed certs (e.g. cockpit-ws).
  serversTransports:
    no-verify-tls:
      insecureSkipVerify: true

  middlewares:
    ipAllowList:
      ipAllowList:
        sourceRange:
{% for cidr in traefik_ip_allowlist %}
          - "{{ cidr }}"
{% endfor %}
