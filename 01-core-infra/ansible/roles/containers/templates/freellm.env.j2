# freellm.env.j2 — Ansible template for freellmapi .env
# Source: 01-core-infra/ansible/roles/containers/templates/
# Non-secret vars (editable); ENCRYPTION_KEY comes from vault.
PORT={{ freellm_port | default('3001') }}
HOST_BIND={{ freellm_host_bind | default('0.0.0.0:3001') }}
NODE_ENV={{ freellm_node_env | default('production') }}
SABLIER_API={{ freellm_sablier_api | default('http://sablier:10000') }}
SESSION_DURATION={{ freellm_session_duration | default('30m') }}
SESSION_DURATION_INACTIVITY={{ freellm_session_inactivity | default('5m') }}

# Encryption key — set via vault vars (see vaults/freellmapi-credentials.yml)
ENCRYPTION_KEY={{ vault_freellm_encryption_key }}
