# Google Apps Script Script Templates

## Template Files for script.google

This directory contains template files for the Google Apps Script projects in the script.google repository.

## Overview

The script.google repository contains two main Google Apps Script projects:

1. **FollowUpReminder** - Gmail reminder scripts for AWV dossier opvolging
2. **LabelReminder** - Universal AI reminders via Gmail labels

This directory provides starter templates and configurations for these scripts, following the repository's structure and coding conventions.

## Templates

### 1. Code.gs Template

Base template for Google Apps Script main code files:

```javascript
/**
 * Google Apps Script Main Template
 * Author: [Your Name]
 * Version: 1.0.0
 * Date: $(date)
 */

// Global variables
const CONFIG = {
    DEBUG: false,
    DRY_RUN: true,
    MAX_THREADS: 50,
    SEARCH_WINDOW_DAYS: 90,
    API_KEY: '',
    // Add other configuration options as needed
};

/**
 * Main function - Entry point for trigger execution
 */
function main() {
    try {
        // Main execution logic here
        Logger.log('Script started');
        
        // Add your main logic here
        // Example: process reminders, send notifications, etc.
        
        Logger.log('Script completed successfully');
    } catch (error) {
        Logger.log('ERROR: ' + error.toString());
        // Handle errors appropriately
        // Send error notifications if needed
    }
}

/**
 * Utility function to log with timestamp
 */
function logWithTimestamp(message) {
    const timestamp = new Date().toISOString();
    Logger.log(`[${timestamp}] ${message}`);
}

/**
 * Function to check if script is in dry-run mode
 */
function isDryRun() {
    return CONFIG.DRY_RUN;
}

/**
 * Function to format date for logging
 */
function formatDate(date) {
    return date.toISOString().replace('T', ' ').substring(0, 19);
}
```

### 2. Test.gs Template

Base template for Google Apps Script test functions:

```javascript
/**
 * Google Apps Script Test Template
 * Author: [Your Name]
 * Version: 1.0.0
 */

// Test configuration
const TEST_CONFIG = {
    TIMEOUT: 30000, // 30 seconds
    MAX_TESTS: 100,
    DRY_RUN: true,
};

/**
 * Run all tests
 */
function testAll() {
    const results = [];
    
    // Add your test functions here
    results.push(testExampleFunction());
    results.push(testConfiguration());
    results.push(testHelperFunctions());
    
    // Summary
    const passed = results.filter(r => r.passed).length;
    const total = results.length;
    
    Logger.log(`Tests completed: ${passed}/${total} passed`);
    
    if (passed < total) {
        Logger.log('Failed tests:');
        results.forEach((result, index) => {
            if (!result.passed) {
                Logger.log(`  Test ${index + 1}: ${result.name} - ${result.error}`);
            }
        });
    }
    
    return {
        passed,
        total,
        results,
        success: passed === total
    };
}

/**
 * Example test function template
 */
function testExampleFunction() {
    try {
        // Test logic here
        const result = 'test result';
        
        if (result !== 'expected') {
            throw new Error(`Expected 'expected', got '${result}'`);
        }
        
        return {
            name: 'Example Function Test',
            passed: true,
            error: null
        };
    } catch (error) {
        return {
            name: 'Example Function Test',
            passed: false,
            error: error.toString()
        };
    }
}

/**
 * Test configuration
 */
function testConfiguration() {
    try {
        // Test configuration values
        if (typeof CONFIG === 'undefined') {
            throw new Error('CONFIG object not defined');
        }
        
        if (CONFIG.DRY_RUN !== true && CONFIG.DRY_RUN !== false) {
            throw new Error('DRY_RUN must be boolean');
        }
        
        return {
            name: 'Configuration Test',
            passed: true,
            error: null
        };
    } catch (error) {
        return {
            name: 'Configuration Test',
            passed: false,
            error: error.toString()
        };
    }
}

/**
 * Test helper functions
 */
function testHelperFunctions() {
    const results = [];
    
    // Test logWithTimestamp function
    try {
        // This would need to be called from the actual script
        // For template purposes, we'll just test the function exists
        if (typeof logWithTimestamp === 'function') {
            results.push({
                name: 'logWithTimestamp Function Test',
                passed: true,
                error: null
            });
        } else {
            results.push({
                name: 'logWithTimestamp Function Test',
                passed: false,
                error: 'Function not found'
            });
        }
    } catch (error) {
        results.push({
            name: 'logWithTimestamp Function Test',
            passed: false,
            error: error.toString()
        });
    }
    
    // Test isDryRun function
    try {
        if (typeof isDryRun === 'function') {
            const isDry = isDryRun();
            if (typeof isDry !== 'boolean') {
                throw new Error('isDryRun should return boolean');
            }
            
            results.push({
                name: 'isDryRun Function Test',
                passed: true,
                error: null
            });
        } else {
            results.push({
                name: 'isDryRun Function Test',
                passed: false,
                error: 'Function not found'
            });
        }
    } catch (error) {
        results.push({
            name: 'isDryRun Function Test',
            passed: false,
            error: error.toString()
        });
    }
    
    return {
        name: 'Helper Functions Test',
        passed: results.every(r => r.passed),
        error: results.some(r => !r.passed) ? 
            results.filter(r => !r.passed).map(r => r.error).join('; ') : 
            null,
        results: results
    };
}

/**
 * Performance test template
 */
function testPerformance() {
    const startTime = new Date().getTime();
    
    // Run test logic here
    // This is a placeholder - implement actual performance test
    
    const endTime = new Date().getTime();
    const duration = endTime - startTime;
    
    Logger.log(`Performance test completed in ${duration}ms`);
    
    return {
        name: 'Performance Test',
        duration,
        passed: duration < TEST_CONFIG.TIMEOUT,
        error: duration >= TEST_CONFIG.TIMEOUT ? 
            `Test took ${duration}ms, exceeding ${TEST_CONFIG.TIMEOUT}ms limit` : 
            null
    };
}
```

