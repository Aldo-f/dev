# 01-core-infra cron jobs — beheerd door install.sh (niet handmatig wijzigen).
# Pad: /etc/cron.d/01-core-infra
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
HOME=__HOME__

# Healthcheck elke 15 minuten
*/15 * * * * __USER__ __CORE_INFRA__/healthcheck.sh >> __CORE_INFRA__/logs/health-cron.log 2>&1

# Sensor daily summary om 00:05
5 0 * * * __USER__ __CORE_INFRA__/sensors-daily-summary.sh

# Nextcloud DB dump om 01:30 (vóór de 03:00 backup, na de dagelijkse piek)
30 1 * * * root /usr/local/bin/nextcloud-db-backup.sh __CORE_INFRA__ >> __CORE_INFRA__/logs/nextcloud-db-backup-cron.log 2>&1

# Backup dagelijks om 03:00
0 3 * * * __USER__ __CORE_INFRA__/backup.sh >> __CORE_INFRA__/logs/backup-cron.log 2>&1

# Thuis v4 watchlist — elk uur (run-serial voorkomt overlap)
0 * * * * __USER__ /usr/local/bin/run-serial.sh thuis-watchlist --max-wait=7200 -- /home/aldo/dev/06-apps-thuis-v4/scripts/watchlist-runner.sh >> /home/aldo/dev/06-apps-thuis-v4/logs/watchlist.log 2>&1
